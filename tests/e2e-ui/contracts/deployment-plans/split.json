{
  "name": "e2e-ui-split",
  "application": "e2e-ui",
  "processes": [
    {
      "id": "api",
      "preset": "query_api",
      "remote_commands": true
    },
    {
      "id": "todo-writer",
      "mounts": [
        {
          "kind": "command",
          "id": "todo.create"
        }
      ]
    },
    {
      "id": "projectors",
      "mounts": [
        {
          "kind": "projector",
          "id": "project_todos"
        }
      ]
    }
  ]
}
