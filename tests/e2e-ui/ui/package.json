{
  "name": "e2e-ui-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo \"\"",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "gen:schema": "cd .. && cargo run -q -p e2e-runner --bin e2e-export-sdl -- ui/schema/user.graphql && GQL_ROLE=admin cargo run -q -p e2e-runner --bin e2e-export-sdl -- ui/schema/admin.graphql",
    "gen:gql": "graphql-codegen --config codegen.ts",
    "gen:commands": "distributed-gen-commands --manifest src/lib/api/commands.manifest.json --commands src/lib/api/commands.generated.ts --operations src/lib/api/commands.operations.gql --policies src/lib/api/commands.policies.generated.ts",
    "gen": "npm run gen:schema && npm run gen:gql && npm run gen:commands",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@auth/core": "^0.40.0",
    "@auth/sveltekit": "^1.10.0",
    "@hops-ops/distributed": "file:../../../js"
  },
  "devDependencies": {
    "@csstools/postcss-global-data": "^4.0.0",
    "@graphql-codegen/cli": "^7.2.0",
    "@graphql-codegen/near-operation-file-preset": "^5.2.1",
    "@graphql-codegen/typed-document-node": "^7.1.0",
    "@graphql-codegen/typescript": "^6.1.0",
    "@graphql-codegen/typescript-operations": "^6.1.0",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@lucide/svelte": "0.577.0",
    "@sveltejs/adapter-node": "5.2.12",
    "@sveltejs/kit": "2.55.0",
    "@sveltejs/vite-plugin-svelte": "5.1.1",
    "@types/node": "^24.7.0",
    "graphql": "^16.14.2",
    "postcss-preset-env": "^11.1.1",
    "svelte": "5.28.6",
    "svelte-check": "4.1.7",
    "typescript": "5.8.3",
    "vite": "6.4.1"
  }
}
