# Non-secret ProviderConfig shape. Secret `aws-creds` is live-only until local ESO exists.
#   hops local aws --gitops ./gitops/cluster
apiVersion: aws.m.upbound.io/v1beta1
kind: ProviderConfig
metadata:
  name: default
  namespace: default
spec:
  credentials:
    source: Secret
    secretRef:
      namespace: default
      name: aws-creds
      key: credentials
