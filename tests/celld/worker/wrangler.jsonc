{
  "name": "distributed-todo-cell",
  "main": "build/worker/shim.mjs",
  "compatibility_date": "2026-01-01",
  "durable_objects": {
    "bindings": [
      { "name": "TODO", "class_name": "TodoCell" },
      { "name": "CHAT", "class_name": "ChatCell" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["TodoCell"] },
    { "tag": "v2", "new_sqlite_classes": ["ChatCell"] }
  ],
  "vars": {
    "DISTRIBUTED_INTERNAL_SECRET": "test-only-internal-secret-change-me-2026",
    "OUTBOX_DRAIN_URL": "http://host.docker.internal:8791/internal/outbox/drain",
    "OUTBOX_DRAIN_INTERVAL_MS": "5000"
  }
}
